<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Pleos 권한은 Pleos App Market과 사전 협의된 범위에서만 쓸 수 있다.
        필요한 것만 선언하고, 새 권한을 추가하면 README의 권한 표도 함께 고친다.
    -->

    <!-- Vehicle SDK: 방향지시등(TurnSignal) CAR_LIGHTS, 기어(Gear) CAR_DRIVE. SDK의 api/Gear, api/TurnSignal에 적힌 권한 -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />

    <!-- NaviHelper SDK: 경로 요청, 주행 중 안내 이벤트 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />

    <!-- TextToSpeech SDK: 음성 안내. 없으면 initialize에서 SecurityException (에뮬레이터 2.1.0에서 확인, normal 권한) -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <!--
        차량 속도(어린이보호구역 과속 경고). Pleos Vehicle SDK에 속도 API가 없어 Android Automotive 표준
        CarPropertyManager PERF_VEHICLE_SPEED를 읽는다. 사용자 허용이 필요한 권한이며, 거부해도 다른 안내는 그대로 나간다.
    -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />

    <application
        android:name=".RoadMateApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RoadMateKorea">
        <!-- CarPropertyManager. 차량이 아니면 없을 수 있어 required=false, 코드에서 확인한다 -->
        <uses-library
            android:name="android.car"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.RoadMateKorea">
            <!--
                주행 중(기어가 P가 아님)에도 화면을 보여 주기 위한 Android Automotive 선언.
                앱이 직접 주행 중 조작을 막는다(읽기 전용 덮개, 설정은 정차 중에만). 영상 재생과 텍스트 입력은 없다.
            -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
