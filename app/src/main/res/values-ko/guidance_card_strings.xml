<?xml version="1.0" encoding="utf-8"?>
<!-- 주행 화면 안내 카드: 머리글(kicker), 한 줄 지시(headline), 한 줄 설명(body). 음성은 guidance_strings.xml의 전체 문장을 읽는다. -->
<resources>
    <string name="card_welcome_right_side_kicker">한국에 오신 것을 환영해요</string>
    <string name="card_welcome_right_side_headline">노란 중앙선을 왼쪽에 두세요.</string>
    <string name="card_welcome_right_side_body">한국은 우측통행이에요. 교차로에서 특히 조심하세요.</string>
    <string name="card_welcome_first_time_kicker">한국에 오신 것을 환영해요</string>
    <string name="card_welcome_first_time_headline">한국 교통 규칙을 안내해 드릴게요.</string>
    <string name="card_welcome_first_time_body">상황마다 그때그때 알려 드려요.</string>
    <string name="card_welcome_experienced_kicker">다시 오셨네요</string>
    <string name="card_welcome_experienced_headline">꼭 필요한 안전 안내만 드릴게요.</string>
    <string name="card_welcome_experienced_body">어린이보호구역 같은 중요한 경고예요.</string>
    <string name="card_lhd_intro_kicker">좌핸들 차량</string>
    <string name="card_lhd_intro_headline">오른쪽이 생각보다 멀어요.</string>
    <string name="card_lhd_intro_body">운전석이 왼쪽이에요. 방향지시등 레버는 핸들 왼쪽에 있어요.</string>
    <string name="card_lhd_mirror_check_kicker">회전하거나 차선을 바꿀 때</string>
    <string name="card_lhd_mirror_check_headline">거울을 보고 고개를 돌려 확인하세요.</string>
    <string name="card_lhd_mirror_check_body">조수석이 이제 오른쪽이에요.</string>
    <string name="card_right_side_left_turn_kicker">좌회전한 뒤</string>
    <string name="card_right_side_left_turn_headline">새 길의 오른쪽으로 다니세요.</string>
    <string name="card_right_side_left_turn_body">노란 중앙선은 왼쪽에 있어요.</string>
    <string name="card_right_turn_rule_kicker">우회전</string>
    <string name="card_right_turn_rule_headline">우회전 신호등이 있으면 녹색 화살표일 때만 도세요.</string>
    <string name="card_right_turn_rule_body">신호등이 없고 빨간불이면 정지선에서 먼저 멈추고, 녹색 신호로 오는 차를 막지 않을 때만 천천히 도세요. 건너거나 건너려는 사람이 있으면 멈추세요.</string>
    <string name="card_left_turn_rule_kicker">좌회전</string>
    <string name="card_left_turn_rule_headline">녹색 좌회전 화살표일 때 도세요.</string>
    <string name="card_left_turn_rule_body">비보호 좌회전 표지가 있으면 양보한 뒤 녹색불에 돌 수 있어요.</string>
    <string name="card_school_zone_ahead_kicker">어린이보호구역 %1$dm 앞</string>
    <string name="card_school_zone_ahead_headline">속도를 줄이고 어린이를 살피세요.</string>
    <string name="card_school_zone_ahead_body">이 구역의 제한 속도 표지를 따르세요.</string>
    <string name="card_school_zone_speed_limit_kicker">어린이보호구역</string>
    <string name="card_school_zone_speed_limit_headline">제한 속도 %1$dkm/h</string>
    <string name="card_school_zone_speed_limit_body">길가의 어린이를 살피세요.</string>
    <string name="card_school_zone_crosswalk_kicker">어린이보호구역</string>
    <string name="card_school_zone_crosswalk_headline">신호등 없는 횡단보도 앞에서 멈추세요.</string>
    <string name="card_school_zone_crosswalk_body">건너는 사람이 없어도요.</string>
    <string name="card_arrived_kicker">도착</string>
    <string name="card_arrived_headline">도착했어요.</string>
    <string name="card_arrived_body">한국에서 안전하게 운전해 주셔서 고마워요.</string>
    <string name="card_bus_lane_ahead_kicker">버스전용차로 %1$dm 앞</string>
    <string name="card_bus_lane_ahead_headline">파란 차로에 들어가지 마세요.</string>
    <string name="card_bus_lane_ahead_body">표지판의 운영 시간을 확인하세요.</string>
    <string name="card_section_start_kicker">구간 단속</string>
    <string name="card_section_start_headline">평균 시속 %1$dkm 이하로 달리세요.</string>
    <string name="card_section_start_body">시작과 끝의 카메라가 속도를 재요.</string>
    <string name="card_section_over_average_kicker">구간 단속</string>
    <string name="card_section_over_average_headline">평균 시속 %1$dkm예요. 속도를 줄이세요.</string>
    <string name="card_section_over_average_body">제한 속도는 시속 %2$dkm예요.</string>
</resources>
