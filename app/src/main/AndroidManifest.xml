<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Pleos 권한은 Pleos App Market과 사전 협의된 범위에서만 쓸 수 있다.
        필요한 것만 선언하고, 새 권한을 추가하면 README의 권한 표도 함께 고친다.
    -->

    <!-- Vehicle SDK: 방향지시등(TurnSignal), 기어(Gear) -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_POWERTRAIN" />

    <!-- NaviHelper SDK: 경로 요청, 주행 중 안내 이벤트 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />

    <!-- FusedLocation SDK -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />

    <!-- TextToSpeech SDK: 음성 안내. 없으면 initialize에서 SecurityException (에뮬레이터 2.1.0에서 확인, normal 권한) -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <!-- SpeechToText SDK (정차 중 통역, 2단계) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".RoadMateApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RoadMateKorea">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.RoadMateKorea">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
